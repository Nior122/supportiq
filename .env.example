# ─────────────────────────────────────────────────────────────
# SupportIQ environment variables. Copy to `.env` and fill in.
# Validation in lib/env.ts will tell you which are required at boot.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database — Neon Postgres with pgvector
# Get both from your Neon project dashboard (Neon provides pooled + direct URLs).
DATABASE_URL="postgresql://user:pass@ep-cool-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-cool-direct.region.aws.neon.tech/dbname?sslmode=require"

# Auth — Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# AI providers — configure the ones you want selectable per bot
OPENAI_API_KEY=sk-xxx
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=sk-ant-xxx
GROQ_API_KEY=gsk_xxx

# Storage — Cloudinary (primary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# OR Vercel Blob (fallback)
BLOB_READ_URL_TOKEN=

# Payments — Stripe (set STRIPE_ENABLED=true to turn on billing UI)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# Rate limiting — Upstash Redis (optional; in-memory fallback in dev)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Embedded widget signing secret (generate: `openssl rand -hex 32`)
EMBED_SIGNING_SECRET=
